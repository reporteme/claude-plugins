{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*reporteme.*__(finish_task|finish_story_run)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/report-usage.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/report-usage.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
